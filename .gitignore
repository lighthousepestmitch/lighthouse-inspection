# Job Book customer data. Local to this Mac only. It lives in the Supabase table
# jobbook_files (behind the master login), uploaded with "Upload from this Mac" on
# http://127.0.0.1:8942/jobbook.html. The repo is public, so none of this may be committed.
# (Files already tracked need: git rm --cached --ignore-unmatch <file>. Copies already in older
# commits stay downloadable from the public repo's history until it is purged or the repo goes
# private. tools/refresh_jobbook.py says so every run.)
jobbook-data/clients_*.json
jobbook-data/properties_*.json
jobbook-data/jobs_*.json
jobbook-data/due_*.json
jobbook-data/replies_*.json
jobbook-data/review_asks.json
# a client name + property id: the refresh reads it from here, the website must not serve it
tools/confirmed_intervals.json
tools/client_intervals.json
tools/client_names.json

# the prospecting list (public business contacts, but still his private list). Uploaded the same way.
jobbook-data/leads.json

# the Oct 2026 check-in campaign record (customer names and what they said). Private like the rest.
jobbook-data/campaign.json

# when each client was last texted or emailed, read off the Mac (customer ids and dates). Private like the rest, uploaded the same way.
jobbook-data/contacted.json
